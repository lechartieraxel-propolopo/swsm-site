---
// Footer enrichi : 4 colonnes desktop, empilé mobile.
import { getCollection } from "astro:content";
import settings from "../../data/site-settings.json";

const partenaires = (await getCollection("partenaires")).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);

const year = new Date().getFullYear();
const f = (settings as any).footer ?? {
  tagline: "Écurie privée du Sud-Ouest. Trois pilotes en Championnat de France de Supermotard.",
  partnersHeader: { eyebrow: "Saison 2026", title: "Merci à nos partenaires.", subtitle: "Ils accompagnent l'écurie cette saison." },
  contactEmail: "contact@swsm-racing-team.fr",
  contactFormLabel: "Formulaire de contact",
  copyright: "SWSM Racing Team — Tous droits réservés"
};

const navLinks = [
  { href: "/coulisses", label: "Coulisses" },
  { href: "/partenaires", label: "Partenaires" },
  { href: "/devenir-partenaire", label: "Devenir partenaire" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="bg-swsm-black text-swsm-white">
  <!-- ─── Bandeau Partenaires — carousel auto-scroll infini, fond blanc ─── -->
  <section class="footer-partners bg-swsm-white text-swsm-black" aria-label="Nos partenaires">
    <div class="pt-20 md:pt-24 pb-12 md:pb-16">
      <header class="text-center mb-12 md:mb-16 max-w-[1240px] mx-auto px-6 md:px-10">
        <p class="text-[10px] md:text-xs uppercase tracking-eyebrow font-display font-medium text-swsm-pink mb-3">
          {f.partnersHeader.eyebrow}
        </p>
        <h2 class="font-display font-bold text-swsm-black tracking-caps-tight uppercase text-2xl md:text-3xl">
          {f.partnersHeader.title}
        </h2>
        <p class="font-body text-sm md:text-base text-swsm-black/55 mt-4 max-w-md mx-auto">
          {f.partnersHeader.subtitle}
        </p>
      </header>

      <!-- Carousel auto-scroll : track dupliqué x2 pour boucle infinie sans saut -->
      <div class="footer-marquee relative overflow-hidden">
        <div class="footer-marquee-track flex w-max animate-footer-scroll gap-4 md:gap-6 px-4">
          {[...partenaires, ...partenaires].map((p, i) => (
            <a
              href={p.data.site || "/partenaires"}
              target={p.data.site ? "_blank" : undefined}
              rel={p.data.site ? "noopener noreferrer" : undefined}
              class="footer-partner-card shrink-0 relative flex items-center justify-center rounded-md overflow-hidden h-28 md:h-32 w-52 md:w-64 px-8 md:px-10 transition-transform duration-300 hover:scale-[1.03] group"
              style={`background-color: ${p.data.couleur || "#171717"};`}
              aria-hidden={i >= partenaires.length ? "true" : undefined}
              aria-label={i < partenaires.length ? `${p.data.nom} — Voir le site` : undefined}
              tabIndex={i >= partenaires.length ? -1 : undefined}
            >
              <img
                src={p.data.logo || "/images/partenaires/Blanc_FondTransparent.png"}
                alt={i < partenaires.length ? `${p.data.nom} — Partenaire SWSM Racing Team` : ""}
                loading="lazy"
                class="footer-partner-logo max-h-[60%] max-w-[80%] w-auto h-auto object-contain select-none pointer-events-none transition-transform duration-500 group-hover:scale-105"
                style={p.data.logoTint === "white"
                  ? "filter: grayscale(1) brightness(1.6) contrast(0.95);"
                  : p.data.logoTint === "black"
                    ? "filter: grayscale(1) brightness(0.4) contrast(1.2);"
                    : "none"}
              />
              {/* outline subtil pour démarquer la carte */}
              <span class="absolute inset-0 rounded-md ring-1 ring-inset ring-swsm-white/10 pointer-events-none"></span>
            </a>
          ))}
        </div>
        <!-- Voiles latéraux pour fade-in/out -->
        <div class="absolute inset-y-0 left-0 w-16 md:w-24 bg-gradient-to-r from-swsm-white to-transparent pointer-events-none z-10" aria-hidden="true"></div>
        <div class="absolute inset-y-0 right-0 w-16 md:w-24 bg-gradient-to-l from-swsm-white to-transparent pointer-events-none z-10" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <div class="max-w-[1240px] mx-auto px-6 md:px-10 py-20 md:py-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-10">
      <!-- Col 1 — Identité -->
      <div>
        <a
          href="/"
          class="font-display font-bold text-2xl tracking-caps-loose uppercase hover:opacity-80 transition-opacity inline-block"
          aria-label="SWSM Racing Team — Accueil"
        >
          SWSM
        </a>
        <p class="font-body text-sm text-swsm-white/65 mt-4 max-w-[280px] leading-relaxed">
          {f.tagline}
        </p>
      </div>

      <!-- Col 2 — Navigation -->
      <div>
        <p class="text-xs uppercase tracking-eyebrow font-display font-medium text-swsm-pink mb-6">
          Navigation
        </p>
        <ul class="space-y-3">
          {
            navLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="font-body text-sm text-swsm-white/70 hover:text-swsm-white hover:translate-x-1 inline-block transition-all duration-200"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3 — Partenaires (vrais noms complets) -->
      <div>
        <p class="text-xs uppercase tracking-eyebrow font-display font-medium text-swsm-pink mb-6">
          Partenaires
        </p>
        <ul class="space-y-3">
          {
            partenaires.map((p) => (
              <li>
                {p.data.site ? (
                  <a
                    href={p.data.site}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-body text-sm text-swsm-white/70 hover:text-swsm-white transition-colors inline-flex items-center gap-2 group"
                  >
                    <span>{p.data.nom}</span>
                    <span class="text-[10px] text-swsm-white/30 group-hover:text-swsm-pink transition-colors">↗</span>
                  </a>
                ) : (
                  <span class="font-body text-sm text-swsm-white/70">{p.data.nom}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4 — Contact -->
      <div>
        <p class="text-xs uppercase tracking-eyebrow font-display font-medium text-swsm-pink mb-6">
          Contact
        </p>
        <a
          href={`mailto:${f.contactEmail}`}
          class="font-body text-sm text-swsm-white hover:text-swsm-pink transition-colors block break-all"
        >
          {f.contactEmail}
        </a>
        <a
          href="/contact"
          class="font-body text-sm text-swsm-white/70 hover:text-swsm-white inline-flex items-center gap-2 mt-4 transition-colors group"
        >
          <span>{f.contactFormLabel}</span>
          <span class="text-swsm-pink group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>

    <!-- Bas du footer -->
    <div class="mt-16 pt-8 border-t border-swsm-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p class="font-body text-xs text-swsm-white/50">
        © {year} {f.copyright}
      </p>
      <ul class="flex flex-wrap items-center gap-6 text-xs">
        <li>
          <a href="/mentions-legales" class="font-body text-swsm-white/50 hover:text-swsm-white transition-colors">
            Mentions légales
          </a>
        </li>
        <li>
          <a href="/confidentialite" class="font-body text-swsm-white/50 hover:text-swsm-white transition-colors">
            Politique de confidentialité
          </a>
        </li>
        <li>
          <a href="/cookies" class="font-body text-swsm-white/50 hover:text-swsm-white transition-colors">
            Cookies
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Carte partenaire : ombre douce au hover pour effet de relief */
  .footer-partner-card {
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .footer-partner-card:hover {
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.25);
  }

  /* Carousel auto-scroll : translate de 0 à -50% (la moitié = un cycle complet
     vu que le track est dupliqué x2). Boucle infinie sans saut. */
  @keyframes footer-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .animate-footer-scroll {
    animation: footer-scroll 28s linear infinite;
  }
  /* Pause au hover pour donner un sentiment de contrôle */
  .footer-marquee:hover .animate-footer-scroll {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-footer-scroll { animation: none; }
  }
</style>
